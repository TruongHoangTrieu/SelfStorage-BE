generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum UnitTypeStatus {
  ACTIVE
  INACTIVE
}

enum StorageUnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

enum ReservationRentalPeriodUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
  TERMINATED
}

enum AccessCodeStatus {
  ACTIVE
  INACTIVE
  REVOKED
  EXPIRED
}

enum ContractItemStatus {
  ACTIVE
  RETURNED
  CANCELLED
  OVERDUE
}

enum HandoverType {
  CHECK_IN
  CHECK_OUT
  INSPECTION
}

enum PaymentType {
  DEPOSIT
  RENTAL
  RENEWAL
  EXTRA_CHARGE
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  VNPAY
  MOMO
  PAYOS
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PolicyValueType {
  NUMBER
  STRING
  BOOLEAN
  JSON
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

enum FeeAmountType {
  FIXED
  PERCENTAGE
}

enum FeeAppliesTo {
  RESERVATION
  CONTRACT
  GENERAL
}

enum FeeTypeStatus {
  ACTIVE
  INACTIVE
}

enum ExtraChargeStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum OverdueStatus {
  OPEN
  RESOLVED
  WAIVED
}

enum SupportCategory {
  UNIT
  LOCK
  ACCESS_CODE
  PAYMENT
  STORED_ITEMS
  LOST_KEY
  DAMAGE
  OTHER
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

// ==========================================
// 2. AUTH / USER (4 models)
// ==========================================

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId @map("role_id")
  fullName     String     @map("full_name")
  email        String     @unique @map("email")
  phone        String?    @map("phone")
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE) @map("status")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  staffFacilityAssignments StaffFacilityAssignment[] @relation("UserFacilityAssignments")
  activityLogs             ActivityLog[]             @relation("UserActivityLogs")
  reservations             Reservation[]             @relation("CustomerReservations")
  rentalContracts          RentalContract[]          @relation("CustomerContracts")
  handoverRecords          HandoverRecord[]          @relation("StaffHandoverRecords")
  createdExtraCharges      ExtraCharge[]             @relation("CreatedExtraCharges")
  appliedDiscountUsages    DiscountUsage[]           @relation("AppliedDiscountUsages")
  requestedRenewals        ContractRenewal[]         @relation("RequestedRenewals")
  approvedRenewals         ContractRenewal[]         @relation("ApprovedRenewals")
  resolvedOverdues         OverdueRecord[]           @relation("ResolvedOverdues")
  customerSupportRequests  SupportRequest[]          @relation("CustomerSupportRequests")
  assignedSupportRequests  SupportRequest[]          @relation("AssignedSupportRequests")
  supportRequestLogs       SupportRequestLog[]       @relation("UserSupportRequestLogs")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model StaffFacilityAssignment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId @map("user_id")
  facilityId String    @db.ObjectId @map("facility_id")
  position   String    @map("position")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  endedAt    DateTime? @map("ended_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User     @relation("UserFacilityAssignments", fields: [userId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([userId])
  @@index([facilityId])
  @@map("staff_facility_assignments")
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId @map("user_id")
  action      String   @map("action")
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation("UserActivityLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ==========================================
// 3. FACILITY / STORAGE UNIT (3 models)
// ==========================================

model Facility {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String         @map("name")
  code        String         @unique @map("code")
  description String?        @map("description")
  phone       String?        @map("phone")
  email       String?        @map("email")
  address     String         @map("address")
  images      String[]       @default([]) @map("images")
  status      FacilityStatus @default(ACTIVE) @map("status")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  staffAssignments StaffFacilityAssignment[]
  storageUnitTypes StorageUnitType[]
  storageUnits     StorageUnit[]
  reservations     Reservation[]
  policies         Policy[]
  supportRequests  SupportRequest[]

  @@map("facilities")
}

model StorageUnitType {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  facilityId    String         @db.ObjectId @map("facility_id")
  name          String         @map("name")
  code          String         @map("code")
  description   String?        @map("description")
  size          Float          @map("size")
  sizeUnit      String         @default("m2") @map("size_unit")
  depositAmount Float          @map("deposit_amount")
  status        UnitTypeStatus @default(ACTIVE) @map("status")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  facility         Facility          @relation(fields: [facilityId], references: [id])
  storageUnits     StorageUnit[]
  pricingRules     PricingRule[]
  reservationItems ReservationItem[]

  @@unique([facilityId, code])
  @@index([facilityId])
  @@index([status])
  @@map("storage_unit_types")
}

model StorageUnit {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  facilityId String            @db.ObjectId @map("facility_id")
  unitTypeId String            @db.ObjectId @map("unit_type_id")
  unitNumber String            @map("unit_number")
  floor      String?           @map("floor")
  status     StorageUnitStatus @default(AVAILABLE) @map("status")
  condition  String            @default("GOOD") @map("condition")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  facility         Facility          @relation(fields: [facilityId], references: [id])
  unitType         StorageUnitType   @relation(fields: [unitTypeId], references: [id])
  reservationItems ReservationItem[]
  contractItems    ContractItem[]

  @@unique([facilityId, unitNumber])
  @@index([facilityId])
  @@index([unitTypeId])
  @@index([status])
  @@map("storage_units")
}

// ==========================================
// 4. RESERVATION (2 models)
// ==========================================

model Reservation {
  id               String                      @id @default(auto()) @map("_id") @db.ObjectId
  reservationCode  String                      @unique @map("reservation_code")
  customerId       String                      @db.ObjectId @map("customer_id")
  facilityId       String                      @db.ObjectId @map("facility_id")
  rentalPeriod     Int                         @map("rental_period")
  rentalPeriodUnit ReservationRentalPeriodUnit @default(MONTHS) @map("rental_period_unit")
  appointmentDate  DateTime                    @map("appointment_date")
  status           ReservationStatus           @default(PENDING) @map("status")
  totalAmount      Float                       @map("total_amount")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  customer       User              @relation("CustomerReservations", fields: [customerId], references: [id])
  facility       Facility          @relation(fields: [facilityId], references: [id])
  items          ReservationItem[]
  rentalContract RentalContract?
  payments       Payment[]
  extraCharges   ExtraCharge[]
  discountUsages DiscountUsage[]

  @@index([customerId])
  @@index([facilityId])
  @@index([status])
  @@index([appointmentDate])
  @@map("reservations")
}

model ReservationItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String   @db.ObjectId @map("reservation_id")
  unitTypeId    String   @db.ObjectId @map("unit_type_id")
  unitId        String?  @db.ObjectId @map("unit_id")
  price         Float    @map("price")
  depositAmount Float    @map("deposit_amount")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  unitType    StorageUnitType @relation(fields: [unitTypeId], references: [id])
  unit        StorageUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([unitTypeId])
  @@index([unitId])
  @@map("reservation_items")
}

// ==========================================
// 5. RENTAL CONTRACT (2 models)
// ==========================================

model RentalContract {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  contractCode  String         @unique @map("contract_code")
  reservationId String         @unique @db.ObjectId @map("reservation_id")
  customerId    String         @db.ObjectId @map("customer_id")
  startDate     DateTime       @map("start_date")
  endDate       DateTime       @map("end_date")
  status        ContractStatus @default(DRAFT) @map("status")
  signedAt      DateTime?      @map("signed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  reservation    Reservation       @relation(fields: [reservationId], references: [id])
  customer       User              @relation("CustomerContracts", fields: [customerId], references: [id])
  contractItems  ContractItem[]
  payments       Payment[]
  extraCharges   ExtraCharge[]
  discountUsages DiscountUsage[]
  renewals       ContractRenewal[]
  overdueRecords OverdueRecord[]

  @@index([customerId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("rental_contracts")
}

model ContractItem {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  contractId       String             @db.ObjectId @map("contract_id")
  unitId           String             @db.ObjectId @map("unit_id")
  rentalPrice      Float              @map("rental_price")
  depositAmount    Float              @map("deposit_amount")
  accessCode       String?            @map("access_code")
  accessCodeStatus AccessCodeStatus   @default(INACTIVE) @map("access_code_status")
  status           ContractItemStatus @default(ACTIVE) @map("status")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  contract        RentalContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  unit            StorageUnit      @relation(fields: [unitId], references: [id])
  handoverRecords HandoverRecord[]
  supportRequests SupportRequest[]
  storedItems     StoredItem[]
  unitAccessLogs  UnitAccessLog[]

  @@index([contractId])
  @@index([unitId])
  @@index([status])
  @@map("contract_items")
}

// ==========================================
// 6. HANDOVER (1 model)
// ==========================================

model HandoverRecord {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  contractItemId String       @db.ObjectId @map("contract_item_id")
  staffId        String       @db.ObjectId @map("staff_id")
  type           HandoverType @map("type")
  condition      String       @map("condition")
  notes          String?      @map("notes")
  photos         Json?        @map("photos")
  inspectionDate DateTime     @map("inspection_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  contractItem ContractItem @relation(fields: [contractItemId], references: [id])
  staff        User         @relation("StaffHandoverRecords", fields: [staffId], references: [id])

  @@index([contractItemId])
  @@index([staffId])
  @@index([type])
  @@index([inspectionDate])
  @@map("handover_records")
}

// ==========================================
// 7. PAYMENT (1 model)
// ==========================================

model Payment {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentCode          String        @unique @map("payment_code")
  reservationId        String?       @db.ObjectId @map("reservation_id")
  contractId           String?       @db.ObjectId @map("contract_id")
  paymentType          PaymentType   @map("payment_type")
  amount               Float         @map("amount")
  paymentMethod        PaymentMethod @default(VNPAY) @map("payment_method")
  transactionReference String?       @map("transaction_reference")
  status               PaymentStatus @default(PENDING) @map("status")
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  contract    RentalContract? @relation(fields: [contractId], references: [id])

  @@index([reservationId])
  @@index([contractId])
  @@index([paymentType])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// ==========================================
// 8. BUSINESS POLICIES (1 model)
// ==========================================

model Policy {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  facilityId    String?         @db.ObjectId @map("facility_id")
  policyType    String          @map("policy_type")
  name          String          @map("name")
  description   String?         @map("description")
  value         Json            @map("value")
  valueType     PolicyValueType @default(JSON) @map("value_type")
  effectiveFrom DateTime        @map("effective_from")
  effectiveTo   DateTime?       @map("effective_to")
  status        PolicyStatus    @default(ACTIVE) @map("status")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([facilityId])
  @@index([policyType])
  @@index([status])
  @@index([effectiveFrom])
  @@map("policies")
}

// ==========================================
// 9. PRICING (1 model)
// ==========================================

model PricingRule {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  unitTypeId    String    @db.ObjectId @map("unit_type_id")
  price         Float     @map("price")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  unitType StorageUnitType @relation(fields: [unitTypeId], references: [id])

  @@index([unitTypeId])
  @@index([effectiveFrom])
  @@map("pricing_rules")
}

// ==========================================
// 10. FEES (2 models)
// ==========================================

model FeeType {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @map("name")
  code          String        @unique @map("code")
  description   String?       @map("description")
  defaultAmount Float         @map("default_amount")
  amountType    FeeAmountType @default(FIXED) @map("amount_type")
  appliesTo     FeeAppliesTo  @default(GENERAL) @map("applies_to")
  status        FeeTypeStatus @default(ACTIVE) @map("status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  extraCharges ExtraCharge[]

  @@map("fee_types")
}

model ExtraCharge {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  contractId    String?           @db.ObjectId @map("contract_id")
  reservationId String?           @db.ObjectId @map("reservation_id")
  feeTypeId     String            @db.ObjectId @map("fee_type_id")
  amount        Float             @map("amount")
  reason        String?           @map("reason")
  status        ExtraChargeStatus @default(PENDING) @map("status")
  createdBy     String            @db.ObjectId @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  contract    RentalContract? @relation(fields: [contractId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  feeType     FeeType         @relation(fields: [feeTypeId], references: [id])
  creator     User            @relation("CreatedExtraCharges", fields: [createdBy], references: [id])

  @@index([contractId])
  @@index([reservationId])
  @@index([feeTypeId])
  @@index([status])
  @@map("extra_charges")
}

// ==========================================
// 11. DISCOUNTS (2 models)
// ==========================================

model Discount {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  code         String         @unique @map("code")
  name         String         @map("name")
  description  String?        @map("description")
  discountType DiscountType   @default(PERCENTAGE) @map("discount_type")
  value        Float          @map("value")
  startDate    DateTime       @map("start_date")
  endDate      DateTime?      @map("end_date")
  maxUsage     Int?           @map("max_usage")
  status       DiscountStatus @default(ACTIVE) @map("status")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  discountUsages DiscountUsage[]

  @@map("discounts")
}

model DiscountUsage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  discountId    String   @db.ObjectId @map("discount_id")
  reservationId String?  @db.ObjectId @map("reservation_id")
  contractId    String?  @db.ObjectId @map("contract_id")
  appliedAmount Float    @map("applied_amount")
  appliedBy     String?  @db.ObjectId @map("applied_by")
  createdAt     DateTime @default(now()) @map("created_at")

  discount    Discount        @relation(fields: [discountId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  contract    RentalContract? @relation(fields: [contractId], references: [id])
  applier     User?           @relation("AppliedDiscountUsages", fields: [appliedBy], references: [id])

  @@index([discountId])
  @@index([reservationId])
  @@index([contractId])
  @@map("discount_usages")
}

// ==========================================
// 12. RENEWAL — FLOW 6 (1 model)
// ==========================================

model ContractRenewal {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  contractId  String        @db.ObjectId @map("contract_id")
  oldEndDate  DateTime      @map("old_end_date")
  newEndDate  DateTime      @map("new_end_date")
  renewalFee  Float         @map("renewal_fee")
  requestedBy String        @db.ObjectId @map("requested_by")
  approvedBy  String?       @db.ObjectId @map("approved_by")
  status      RenewalStatus @default(PENDING) @map("status")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  contract  RentalContract @relation(fields: [contractId], references: [id])
  requester User           @relation("RequestedRenewals", fields: [requestedBy], references: [id])
  approver  User?          @relation("ApprovedRenewals", fields: [approvedBy], references: [id])

  @@index([contractId])
  @@index([requestedBy])
  @@index([approvedBy])
  @@index([status])
  @@map("contract_renewals")
}

// ==========================================
// 13. OVERDUE — FLOW 6 (1 model)
// ==========================================

model OverdueRecord {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  contractId       String        @db.ObjectId @map("contract_id")
  overdueStartDate DateTime      @map("overdue_start_date")
  overdueDays      Int           @map("overdue_days")
  overdueFee       Float         @map("overdue_fee")
  status           OverdueStatus @default(OPEN) @map("status")
  resolvedBy       String?       @db.ObjectId @map("resolved_by")
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  contract RentalContract @relation(fields: [contractId], references: [id])
  resolver User?          @relation("ResolvedOverdues", fields: [resolvedBy], references: [id])

  @@index([contractId])
  @@index([status])
  @@index([overdueStartDate])
  @@map("overdue_records")
}

// ==========================================
// 14. SUPPORT — FLOW 7 (2 models)
// ==========================================

model SupportRequest {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  requestCode     String          @unique @map("request_code")
  customerId      String          @db.ObjectId @map("customer_id")
  contractItemId  String?         @db.ObjectId @map("contract_item_id")
  facilityId      String          @db.ObjectId @map("facility_id")
  category        SupportCategory @default(OTHER) @map("category")
  subject         String          @map("subject")
  description     String          @map("description")
  priority        SupportPriority @default(MEDIUM) @map("priority")
  status          SupportStatus   @default(OPEN) @map("status")
  assignedStaffId String?         @db.ObjectId @map("assigned_staff_id")
  photos          Json?           @map("photos")
  createdAt       DateTime        @default(now()) @map("created_at")
  resolvedAt      DateTime?       @map("resolved_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  customer      User                @relation("CustomerSupportRequests", fields: [customerId], references: [id])
  contractItem  ContractItem?       @relation(fields: [contractItemId], references: [id])
  facility      Facility            @relation(fields: [facilityId], references: [id])
  assignedStaff User?               @relation("AssignedSupportRequests", fields: [assignedStaffId], references: [id])
  logs          SupportRequestLog[]

  @@index([customerId])
  @@index([contractItemId])
  @@index([facilityId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@map("support_requests")
}

model SupportRequestLog {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  supportRequestId String         @db.ObjectId @map("support_request_id")
  userId           String         @db.ObjectId @map("user_id")
  note             String         @map("note")
  oldStatus        SupportStatus? @map("old_status")
  newStatus        SupportStatus? @map("new_status")
  createdAt        DateTime       @default(now()) @map("created_at")

  supportRequest SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  user           User           @relation("UserSupportRequestLogs", fields: [userId], references: [id])

  @@index([supportRequestId])
  @@index([userId])
  @@index([createdAt])
  @@map("support_request_logs")
}

// ==========================================
// 15. STORED ITEMS & ACCESS LOGS — FLOW 3 (2 models)
// ==========================================

model StoredItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  contractItemId String       @db.ObjectId @map("contract_item_id")
  name           String       @map("name")
  category       String?      @map("category")
  quantity       Int          @default(1) @map("quantity")
  photoUrl       String?      @map("photo_url")
  description    String?      @map("description")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  contractItem ContractItem @relation(fields: [contractItemId], references: [id], onDelete: Cascade)

  @@index([contractItemId])
  @@map("stored_items")
}

model UnitAccessLog {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  contractItemId String       @db.ObjectId @map("contract_item_id")
  accessCode     String?      @map("access_code")
  accessMethod   String       @default("PIN_CODE") @map("access_method")
  status         String       @default("SUCCESS") @map("status")
  notes          String?      @map("notes")
  accessedAt     DateTime     @default(now()) @map("accessed_at")

  contractItem ContractItem @relation(fields: [contractItemId], references: [id], onDelete: Cascade)

  @@index([contractItemId])
  @@index([accessedAt])
  @@map("unit_access_logs")
}
