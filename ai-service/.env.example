# ===== AI Service (Python FastAPI) =====
AI_PORT=8000

# Khóa nội bộ dùng chung giữa NestJS <-> AI Service (phải trùng AI_INTERNAL_KEY bên NestJS)
AI_INTERNAL_KEY=change_me_internal_key

# MongoDB (dùng chung DATABASE_URL với NestJS - cluster Atlas)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/selfstorage"

# NestJS base URL (AI Service gọi ngược các endpoint /api/internal/*)
NEST_BASE_URL=http://localhost:5000/api

# ===== LLM =====
# gemini | local   (local = không cần API key, dùng rule-based + model tự huấn luyện)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ===== Tham số kỹ năng =====
# Hệ số lối đi k trong công thức V = sum(q*v) * (1 + k)
AISLE_FACTOR=0.18
# Chiều cao khả dụng mặc định (m) khi tên loại kho không ghi CBM
DEFAULT_UNIT_HEIGHT_M=2.0
# Ngưỡng tương đồng tối thiểu cho RAG
RAG_MIN_SCORE=0.35
RAG_TOP_K=4
